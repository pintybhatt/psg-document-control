# Use a separate protected directory and project for every environment.
DCMS_ENVIRONMENT=uat
DCMS_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_APPROVED_DIGEST
DCMS_BIND_ADDRESS=127.0.0.1
DCMS_HTTP_PORT=REPLACE_WITH_FREE_PORT
DCMS_APP_ENV_FILE=/ABSOLUTE/ENVIRONMENT/app.env
DCMS_DB_DATABASE=dcms_uat
DCMS_DB_USERNAME=dcms_uat
DCMS_DB_PASSWORD_FILE=/ABSOLUTE/ENVIRONMENT/db-password
DCMS_DB_ROOT_PASSWORD_FILE=/ABSOLUTE/ENVIRONMENT/db-root-password
