# INACTIVE: render placeholders offline, review, then install only with host approval.
# Render ONLY DCMS_UAT_HOSTNAME, DCMS_TLS_CERTIFICATE, DCMS_TLS_KEY, DCMS_HTTP_PORT.
# Hostname: approved DNS name without scheme/port; paths: absolute, no whitespace.
# Separate server block; do not replace any existing file or default server.
server {
    listen 8444 ssl;
    server_name ${DCMS_UAT_HOSTNAME};
    ssl_certificate ${DCMS_TLS_CERTIFICATE};
    ssl_certificate_key ${DCMS_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($host != ${DCMS_UAT_HOSTNAME}) { return 444; }
    client_max_body_size 27m;
    client_body_timeout 60s;
    access_log /var/log/nginx/dcms-uat-access.log;
    error_log /var/log/nginx/dcms-uat-error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ~ ^/(storage|\.env|\.git)(/|$) { deny all; }
    location / {
        proxy_pass http://127.0.0.1:${DCMS_HTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host ${DCMS_UAT_HOSTNAME}:8444;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 8444;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
