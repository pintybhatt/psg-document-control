# Copy outside Git into /srv/dcms-uat/config/compose.env, owner-only.
# Always use project dcms-uat-xppl and both release + UAT Compose files.
DCMS_ENVIRONMENT=uat
DCMS_IMAGE=ghcr.io/pintybhatt/psg-document-control@sha256:REPLACE_WITH_APPROVED_DIGEST
DCMS_BIND_ADDRESS=127.0.0.1
DCMS_HTTP_PORT=18084
DCMS_APP_ENV_FILE=/srv/dcms-uat/config/app.env
DCMS_DB_DATABASE=dcms_uat
DCMS_DB_USERNAME=dcms_uat
DCMS_DB_PASSWORD_FILE=/srv/dcms-uat/config/db-password
DCMS_DB_ROOT_PASSWORD_FILE=/srv/dcms-uat/config/db-root-password
