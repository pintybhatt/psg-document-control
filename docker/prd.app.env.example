# Copy outside Git to /srv/dcms-prd/config/app.env, owner-only (0600).
# Generate independent Production secrets during separately approved server setup.
APP_NAME="XPPL DCMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dcms.phonesackgroup.com:9444
APP_KEY=
APP_PREVIOUS_KEYS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
# Set only the observed Production ingress gateway IP; never copy UAT's proxy list.
TRUSTED_PROXIES=
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dcms_prd
DB_USERNAME=dcms_prd
DB_PASSWORD=
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_COOKIE=dcms_prd_session
CACHE_STORE=database
CACHE_PREFIX=dcms_prd_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=stderr
DCMS_MAX_UPLOAD_KB=25600
PHP_UPLOAD_MAX_FILESIZE=25M
PHP_POST_MAX_SIZE=27M
HTTP_UPLOAD_LIMIT_BYTES=28311552
PHP_MEMORY_LIMIT=256M
XPPL_UAT_IMPORT_ENABLED=false
# No current mail delivery functionality. Do not log confidential message bodies.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="XPPL DCMS"
