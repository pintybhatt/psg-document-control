APP_NAME="XPPL DCMS"
APP_ENV=uat
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_APPROVED_HOST
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
# Explicit comma-separated ingress IPs/CIDRs only. Empty means trust none.
TRUSTED_PROXIES=
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dcms_uat
DB_USERNAME=dcms_uat
DB_PASSWORD=
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=dcms_uat_session
CACHE_STORE=database
CACHE_PREFIX=dcms_uat_
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=stderr
DCMS_MAX_UPLOAD_KB=25600
PHP_UPLOAD_MAX_FILESIZE=25M
PHP_POST_MAX_SIZE=27M
HTTP_UPLOAD_LIMIT_BYTES=28311552
PHP_MEMORY_LIMIT=256M
# No current mail delivery functionality. Do not log confidential message bodies.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="XPPL DCMS"
