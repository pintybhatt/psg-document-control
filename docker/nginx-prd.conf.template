# INACTIVE: render offline and review before separately approved installation.
# Render ONLY DCMS_TLS_CERTIFICATE and DCMS_TLS_KEY, absolute paths without whitespace.
# Independent Production server block; do not replace UAT or any existing configuration.
server {
    listen 9444 ssl;
    server_name dcms.phonesackgroup.com;
    ssl_certificate ${DCMS_TLS_CERTIFICATE};
    ssl_certificate_key ${DCMS_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($host != dcms.phonesackgroup.com) { return 444; }
    client_max_body_size 27m;
    client_body_timeout 60s;
    access_log /var/log/nginx/dcms-prd-access.log;
    error_log /var/log/nginx/dcms-prd-error.log warn;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ~* ^/(storage|document-vault|private|\.env|\.git)(/|$) { deny all; }
    location / {
        proxy_pass http://127.0.0.1:18085;
        proxy_http_version 1.1;
        proxy_set_header Host dcms.phonesackgroup.com:9444;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 9444;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
