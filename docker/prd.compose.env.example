# Copy outside Git to /srv/dcms-prd/config/compose.env, owner-only (0600).
# Always pass --project-name dcms-prd-xppl with release + prd Compose files.
DCMS_ENVIRONMENT=production
DCMS_IMAGE=ghcr.io/pintybhatt/psg-document-control@sha256:REPLACE_WITH_APPROVED_DIGEST
DCMS_BIND_ADDRESS=127.0.0.1
DCMS_HTTP_PORT=18085
DCMS_APP_ENV_FILE=/srv/dcms-prd/config/app.env
DCMS_DB_DATABASE=dcms_prd
DCMS_DB_USERNAME=dcms_prd
DCMS_DB_PASSWORD_FILE=/srv/dcms-prd/config/db-password
DCMS_DB_ROOT_PASSWORD_FILE=/srv/dcms-prd/config/db-root-password
